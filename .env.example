# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, Railway, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/cooachly?schema=public"

# Random 32+ byte secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Public URL of the deployed app (used for Stripe redirect URLs, links in emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe API keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Signing secret for the /api/stripe/webhook endpoint (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Reminders (email / WhatsApp) ---

# Resend for email (https://resend.com/api-keys)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Cooachly <notifications@yourdomain.com>"

# Twilio for WhatsApp (https://console.twilio.com)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
# Twilio WhatsApp sender, in the "whatsapp:+1415..." format Twilio gives you
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Secret Vercel Cron (or an external scheduler) must send as
# `Authorization: Bearer <value>` or `?secret=<value>` when calling
# /api/cron/reminders. Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# --- Video calls, recording & AI summaries ---

# Daily.co for video rooms (https://dashboard.daily.co/developers)
DAILY_API_KEY="..."
# Live transcription is billed per participant-minute on top of Daily's free
# video minutes (cheaper than cloud recording, and no audio/video is stored —
# just the text transcript). Set to "true" to transcribe sessions and enable
# the AI-summary pipeline below; leave unset/false to keep video calls free
# with no transcript or summaries. Also requires enabling transcription on
# your Daily domain with a Deepgram API key — see README.
DAILY_ENABLE_TRANSCRIPTION="false"
# Optional: signing secret for the Daily webhook, if you enable webhook signing
DAILY_WEBHOOK_SECRET=""

# OpenAI for session/monthly summary generation (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."

# --- File sharing (test files / student answers) ---

# Vercel Blob storage token. Add the "Blob" storage integration to your
# Vercel project (Storage tab) and it's injected automatically in
# production; for local dev, copy the token it generates.
BLOB_READ_WRITE_TOKEN=""

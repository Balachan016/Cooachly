// Prisma schema for Cooachly — a coaching platform with admin, professor, and student roles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations (prisma migrate deploy) use this instead of the pooled
  // DATABASE_URL. Postgres advisory locks (which migrations take to avoid
  // concurrent runs) are session-scoped, but Neon's pooled connection can
  // hand a session's statements to different underlying connections
  // mid-transaction — causing exactly the recurring
  // "Timed out trying to acquire a postgres advisory lock" (P1002) failures
  // this project keeps hitting on deploy. A direct, unpooled connection
  // avoids that. DIRECT_URL must be set wherever this builds (see README) —
  // Prisma errors at build time if it's missing, so add it before deploying
  // this change.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  PROFESSOR
  STUDENT
}

// Which tab/vertical a user, enquiry, or coach application belongs to.
// Cooachly (academic tutoring) and Arts (Carnatic vocals) are run as
// fully separate platforms sharing one codebase and database: distinct
// admins, distinct professors/students, distinct marketing site — a user
// or lead created under one Site never appears in the other's queries.
enum Site {
  COOACHLY
  ARTS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  COVERED_BY_SUBSCRIPTION
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CoachApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum DemoRequestStatus {
  PENDING
  SCHEDULED
  JOINED
  DROPPED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

// What a logged admin/superadmin action or account event was. Free-text
// `detail` on AuditLog carries the specifics (e.g. "STUDENT -> PROFESSOR").
enum AuditAction {
  LOGIN
  LOGOUT
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_DELETED
  COACH_APPLICATION_STATUS_CHANGED
  USER_ROLE_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_DELETED
  USER_PROFILE_UPDATED
  PASSWORD_RESET_BY_ADMIN
  ACCOUNT_INVITE_SENT
  ACCOUNT_INVITE_REDEEMED
  DEMO_REQUEST_SCHEDULED
  DEMO_REQUEST_STATUS_CHANGED
  ADMIN_ACCOUNT_CREATED
  SCHEDULE_IMPORTED
  ADMIN_VIEWED_USER
  ADMIN_SWITCHED_TO_USER
  ADMIN_RETURNED_TO_OWN_ACCOUNT
  TEST_ASSIGNED_BY_ADMIN
  BOOKING_RESCHEDULE_PROPOSED
  BOOKING_RESCHEDULE_DECLINED
  ACCOUNT_CREATED_BY_ADMIN
  BULK_BOOKING_CREATED
  MONTHLY_PAYMENT_RECORDED
  SLOT_VIEW_OVERRIDE_CHANGED
  PROFESSOR_PAYOUT_RECORDED
  SUBSCRIPTION_EXPENSE_LOGGED
  EXCHANGE_RATE_UPDATED
}

model User {
  id                   String    @id @default(cuid())
  site                 Site      @default(COOACHLY)
  name                 String
  email                String
  phone                String?
  parentName           String?
  parentPhone          String?
  passwordHash         String
  role                 Role      @default(STUDENT)
  // Human-friendly identifier assigned once at account creation: ST0001,
  // PR0001, AD0001, sequential per role. Null for SUPERADMIN, which never
  // gets one. A professor's code doubles as the referral code applicants
  // enter on "Become a Coach" (see CoachApplication.referralCode).
  code                 String?   @unique
  timezone             String    @default("UTC")
  isActive             Boolean   @default(true)
  stripeCustomerId     String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  professorProfile     ProfessorProfile?

  availabilities       Availability[] @relation("ProfessorAvailability")

  bookingsAsStudent    Booking[] @relation("StudentBookings")
  bookingsAsProfessor  Booking[] @relation("ProfessorBookings")

  sentMessages         Message[] @relation("SentMessages")
  receivedMessages     Message[] @relation("ReceivedMessages")

  subscriptionsAsStudent   Subscription[] @relation("StudentSubscriptions")
  subscriptionsAsProfessor Subscription[] @relation("ProfessorSubscriptions")

  passwordResetTokens  PasswordResetToken[]

  attachmentsUploaded      Attachment[]     @relation("UploadedAttachments")
  monthlySummariesAsStudent   MonthlySummary[] @relation("StudentMonthlySummaries")
  monthlySummariesAsProfessor MonthlySummary[] @relation("ProfessorMonthlySummaries")

  studentProfile       StudentProfile?

  reviewsGiven         Review[] @relation("ReviewsGiven")
  reviewsReceived      Review[] @relation("ReviewsReceived")

  notificationLogs     NotificationLog[]
  callAttendanceEvents CallAttendanceEvent[]
  pushSubscriptions    PushSubscription[]

  auditLogsAsActor     AuditLog[] @relation("AuditActor")

  demoRequestsAsProfessor DemoRequest[] @relation("DemoRequestProfessor")

  testsCreated         Test[]           @relation("TestsCreated")
  testAssignments      TestAssignment[] @relation("TestAssignments")

  enrollmentsAsStudent       StudentEnrollment[]    @relation("StudentEnrollments")
  enrollmentsAsProfessor     StudentEnrollment[]    @relation("ProfessorEnrollments")
  monthlyPaymentsAsStudent   MonthlyPayment[]       @relation("StudentMonthlyPayments")
  monthlyPaymentsAsProfessor MonthlyPayment[]       @relation("ProfessorMonthlyPayments")
  monthlyPaymentsRecorded    MonthlyPayment[]       @relation("MonthlyPaymentsRecorded")
  professorPayouts           ProfessorPayout[]      @relation("ProfessorPayouts")
  professorPayoutsRecorded   ProfessorPayout[]      @relation("ProfessorPayoutsRecorded")
  subscriptionExpensesLogged SubscriptionExpense[]  @relation("SubscriptionExpensesRecorded")
  exchangeRatesUpdated       ExchangeRate[]         @relation("ExchangeRatesUpdated")

  @@unique([site, email])
}

// General-purpose audit trail for the superadmin dashboard: authentication
// events, booking cancellations, admin-approval decisions, and admin/account
// management actions. `actor` is nullable so a record survives the actor's
// account being deleted; `targetType`/`targetId` point at whatever entity
// the action was about (a User, a Booking, a CoachApplication, ...).
model AuditLog {
  id         String      @id @default(cuid())
  site       Site        @default(COOACHLY)
  action     AuditAction
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetType String?
  targetId   String?
  detail     String?
  createdAt  DateTime    @default(now())

  @@index([site, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country          String?  // "US" | "Middle East" | "Singapore"
  curriculumLevel  String?  // US only: "Accelerated" | "Honors" | "AP"
  curriculum       String?  // Middle East / Singapore: "CBSE"
  grade            String?  // "9" | "10" | "11" | "12"
  syllabusFileName String?
  syllabusFileUrl  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Enquiry {
  id        String   @id @default(cuid())
  site      Site     @default(COOACHLY)
  name      String
  email     String
  phone     String?
  country   String?
  message   String
  createdAt DateTime @default(now())

  @@index([site])
}

// A free-demo request from the public site. No slot is picked up front —
// the lead just lands here for an admin to review, then schedule a call
// with the requester and a professor, and track whether it ends up
// converting (JOINED) or not (DROPPED). Reminder emails go out to the
// requester and admins every other day while it's PENDING or SCHEDULED.
model DemoRequest {
  id                 String            @id @default(cuid())
  site               Site              @default(COOACHLY)
  name               String
  email              String
  phone              String?
  subject            String
  grade              String?
  referredBy         String?
  timezone           String?
  status             DemoRequestStatus @default(PENDING)
  professorId        String?
  professor          User?             @relation("DemoRequestProfessor", fields: [professorId], references: [id], onDelete: SetNull)
  scheduledAt        DateTime?
  meetingLink        String?
  adminNotes         String?
  lastReminderSentAt DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  booking            Booking?

  @@index([site, status])
  @@index([professorId])
}

model CoachApplication {
  id              String                 @id @default(cuid())
  site            Site                   @default(COOACHLY)
  name            String
  email           String
  phone           String?
  age             Int?
  gender          String?
  subject         String
  curricula       String[]               @default([])
  yearsExperience Int?
  qualifications  String
  availability    String?
  message         String?
  // The referring professor's code (e.g. "PR0007"), as typed by the
  // applicant — stored as free text rather than a relation so a code that's
  // mistyped or later reassigned never blocks submission; resolved back to
  // the matching professor for display when reviewing applications.
  referralCode    String?
  status          CoachApplicationStatus @default(PENDING)
  createdAt       DateTime               @default(now())

  @@index([site])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Accounts are no longer created via open public self-registration — an
// admin sends a personalized invite (typically after a free demo), and the
// recipient redeems it at /register/[token] to set their own password. No
// User row exists until the invite is redeemed.
model AccountInviteToken {
  id        String    @id @default(cuid())
  site      Site      @default(COOACHLY)
  name      String
  email     String
  role      Role      @default(STUDENT)
  phone     String?
  message   String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([site, email])
}

model ProfessorProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline             String   @default("")
  bio                  String   @default("")
  subject              String   @default("")
  hourlyRateCents      Int      @default(5000)
  monthlyPriceCents    Int?
  currency             String   @default("usd")
  stripeProductId      String?
  stripePriceId        String?
  stripeSubscriptionPriceId String?
  curricula            String[] @default([]) // e.g. "CBSE", "AP", "Honors", "Accelerated"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Availability {
  id           String   @id @default(cuid())
  professorId  String
  professor    User     @relation("ProfessorAvailability", fields: [professorId], references: [id], onDelete: Cascade)
  // Exactly one of dayOfWeek/date is set: dayOfWeek for a window that
  // repeats every week, date for a one-off window open on that single
  // calendar day only (e.g. an extra Saturday). date is stored as a plain
  // UTC-midnight calendar date — compared as a date string, never as an
  // instant — so it isn't affected by `timezone` below.
  dayOfWeek    Int?     // 0 (Sunday) - 6 (Saturday)
  date         DateTime?
  startTime    String   // "HH:mm" in the professor's timezone
  endTime      String   // "HH:mm" in the professor's timezone
  timezone     String   // IANA timezone name, e.g. "America/New_York"
  sessionLengthMinutes Int @default(60) // 45, 60, 75, or 90
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([professorId])
}

model Booking {
  id                     String        @id @default(cuid())
  studentId              String
  student                User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  professorId            String
  professor              User          @relation("ProfessorBookings", fields: [professorId], references: [id], onDelete: Cascade)
  startAt                DateTime      // UTC
  endAt                  DateTime      // UTC
  status                 BookingStatus @default(PENDING)
  paymentStatus          PaymentStatus @default(UNPAID)
  isDemo                 Boolean       @default(false)
  demoRequestId          String?       @unique
  demoRequest            DemoRequest?  @relation(fields: [demoRequestId], references: [id], onDelete: SetNull)
  rescheduledAt          DateTime?
  // Who proposed the reschedule that actually took effect (set alongside
  // rescheduledAt by acceptRescheduleProposal, and never cleared again,
  // unlike rescheduleProposedBy below) — lets the monthly reschedule quota
  // be charged to whichever party spent it, student or professor, even
  // after the pending-proposal fields are cleared on acceptance.
  rescheduledByRole      Role?
  // A pending reschedule proposal — set by proposeReschedule, cleared by
  // acceptRescheduleProposal (which also moves startAt/endAt) or
  // declineRescheduleProposal. startAt/endAt only change on acceptance, so a
  // proposal never moves the session until the other party agrees.
  rescheduleProposedStartAt  DateTime?
  rescheduleProposedBy       Role?
  rescheduleProposedReason   String?
  rescheduleProposedAt       DateTime?
  priceCents             Int
  currency               String        @default("usd")
  meetingLink            String?
  notes                  String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId  String?

  dailyRoomName          String?
  dailyRoomUrl           String?
  recordingUrl           String?
  transcript             String?
  aiSummary              String?
  summarySentAt          DateTime?

  reminder24hSentAt      DateTime?
  reminder1hSentAt       DateTime?
  reminder5mSentAt       DateTime?
  feedbackRequestSentAt  DateTime?

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  messages               Message[]
  attachments            Attachment[]
  reviews                Review[]
  notificationLogs       NotificationLog[]
  callAttendanceEvents   CallAttendanceEvent[]

  @@index([professorId, startAt])
  @@index([studentId, startAt])
}

model NotificationLog {
  id        String              @id @default(cuid())
  bookingId String?
  booking   Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel   NotificationChannel
  kind      String              // "24h" | "1h" | "5m" | "test"
  status    NotificationStatus
  error     String?
  // Addresses actually used for this message: an email address (with display
  // name, for the sender) or an E.164 WhatsApp number. Null on rows logged
  // before these were recorded, or when the channel isn't configured.
  sender    String?
  recipient String?
  cc        String? // comma-separated CC'd email addresses, if any
  // `status` above only reflects that Twilio/Resend *accepted* the message —
  // it says nothing about whether it was actually delivered. For WhatsApp,
  // providerMessageSid is the Twilio Message SID so the /api/twilio/status
  // webhook can match its async delivery callback back to this row and fill
  // in deliveryStatus (queued/sent/delivered/read/undelivered/failed) and
  // deliveryError once Twilio reports it.
  providerMessageSid String?
  deliveryStatus      String?
  deliveryError       String?
  deliveryUpdatedAt   DateTime?
  createdAt DateTime            @default(now())

  @@index([bookingId])
  @@index([providerMessageSid])
}

enum CallEventType {
  JOINED
  LEFT
}

// One row per Daily.co "participant.joined"/"participant.left" webhook
// delivery for a booking's video call — the full join/leave history behind
// the attendance list shown on that booking's class log. userId is only set
// when the participant joined through /api/daily/join/[bookingId] (which
// tags the Daily meeting token with our own user id); a join via the bare
// room link instead (no token) leaves userId null and keeps whatever name
// Daily's own join screen collected in participantName.
model CallAttendanceEvent {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  participantName String?
  eventType       CallEventType
  occurredAt      DateTime
  createdAt       DateTime      @default(now())

  @@index([bookingId])
}

// A browser/device the user has allowed to receive Web Push notifications
// (installed PWA on iOS/Android, or a desktop browser). One user can have
// several — one per device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AttachmentKind {
  TEST
  ANSWER
}

enum TestQuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  LONG_ANSWER
  FILE_UPLOAD
}

enum TestAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  GRADED
  SCORE_SHARED
}

model Attachment {
  id           String         @id @default(cuid())
  bookingId    String
  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User           @relation("UploadedAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  fileName     String
  fileUrl      String
  createdAt    DateTime       @default(now())

  @@index([bookingId])
}

model MonthlySummary {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("StudentMonthlySummaries", fields: [studentId], references: [id], onDelete: Cascade)
  professorId  String
  professor    User     @relation("ProfessorMonthlySummaries", fields: [professorId], references: [id], onDelete: Cascade)
  subject      String
  periodStart  DateTime
  periodEnd    DateTime
  sessionCount Int
  summary      String
  createdAt    DateTime @default(now())

  @@unique([studentId, professorId, periodStart])
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId   String
  receiver     User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  body         String
  readAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}

model Subscription {
  id                   String             @id @default(cuid())
  studentId            String
  student              User               @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: Cascade)
  professorId          String
  professor            User               @relation("ProfessorSubscriptions", fields: [professorId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([studentId, professorId])
}

model Review {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raterId         String
  rater           User     @relation("ReviewsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId         String
  ratee           User     @relation("ReviewsReceived", fields: [rateeId], references: [id], onDelete: Cascade)
  // Structured post-call feedback questions, asked of both the student and
  // the professor about each other after a session completes.
  joinedOnTime    Boolean?
  explainedClearly Boolean?
  stayedOnTopic   Boolean?
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  @@unique([bookingId, raterId])
  @@index([rateeId])
}

// A professor-authored test: a due date plus an ordered list of questions.
// Questions can only be added/edited/removed while assignedAt is null —
// assigning the test to students locks its content so grading always refers
// to what the students actually saw.
model Test {
  id          String    @id @default(cuid())
  site        Site      @default(COOACHLY)
  professorId String
  professor   User      @relation("TestsCreated", fields: [professorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Shown to the student on a one-time intro screen before the questions
  // (and before the timer starts) — not graded content.
  instructions String?
  formulaSheet String?
  dueAt       DateTime
  // How long a student gets to actively work on the test once they open it
  // (see TestAssignment.timeSpentSeconds) — independent of dueAt, which is
  // just the deadline by which they must have taken it at all.
  durationMinutes Int @default(30)
  assignedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   TestQuestion[]
  assignments TestAssignment[]

  @@index([professorId])
  @@index([site])
}

model TestQuestion {
  id          String           @id @default(cuid())
  testId      String
  test        Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  order       Int
  type        TestQuestionType
  prompt      String
  maxMarks    Int
  // Professor's own grading reference (e.g. the expected answer) — never
  // shown to the student.
  modelAnswer String?
  createdAt   DateTime         @default(now())

  options TestQuestionOption[]
  answers TestAnswer[]

  @@index([testId])
}

model TestQuestionOption {
  id         String       @id @default(cuid())
  questionId String
  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean      @default(false)

  selectedBy TestAnswer[] @relation("SelectedOption")

  @@index([questionId])
}

// One student's attempt at a Test. totalMarks is snapshotted from the
// questions' maxMarks at assignment time, since the test is locked by then
// anyway — grading always refers to this fixed total.
model TestAssignment {
  id            String               @id @default(cuid())
  testId        String
  test          Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId     String
  student       User                 @relation("TestAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  status        TestAssignmentStatus @default(ASSIGNED)
  assignedAt    DateTime             @default(now())
  startedAt     DateTime?
  submittedAt   DateTime?
  gradedAt      DateTime?
  scoreSharedAt DateTime?
  totalMarks    Int                  @default(0)
  totalScore    Int?
  // Accumulated active seconds against the test's durationMinutes — only
  // incremented by a heartbeat while the student has the test page open, so
  // it naturally pauses when they close/leave and resumes where it left off.
  timeSpentSeconds Int @default(0)
  // Stamped once the ~24h-before-due nudge email goes out, so the cron job
  // doesn't send it twice.
  dueReminderSentAt DateTime?

  answers TestAnswer[]

  @@unique([testId, studentId])
  @@index([studentId])
}

model TestAnswer {
  id               String              @id @default(cuid())
  assignmentId     String
  assignment       TestAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId       String
  question         TestQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   TestQuestionOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)
  textAnswer       String?
  fileName         String?
  fileUrl          String?
  marksAwarded     Int?
  comment          String?
  updatedAt        DateTime            @updatedAt

  @@unique([assignmentId, questionId])
}

// Cooachly-only (Arts doesn't run payment through the platform at all — see
// bookSlots). One row per student/professor pairing — each professor teaches
// one subject (ProfessorProfile.subject), so this pairing already identifies
// "this student's <subject> plan with this professor" without a separate
// subject field. monthlyClassQuota defaults to 8 but is editable per pairing.
// slotViewOverride lets an admin let the student keep browsing/booking this
// professor's open slots for a period with no MonthlyPayment on file.
model StudentEnrollment {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  professorId       String
  professor         User     @relation("ProfessorEnrollments", fields: [professorId], references: [id], onDelete: Cascade)
  monthlyClassQuota Int      @default(8)
  slotViewOverride  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([studentId, professorId])
}

// A recorded offline payment covering one calendar month's package for one
// student/professor pairing — its mere existence for the current month is
// what the slot-visibility gate checks (see lib/billing.ts), alongside
// StudentEnrollment.slotViewOverride.
model MonthlyPayment {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("StudentMonthlyPayments", fields: [studentId], references: [id], onDelete: Cascade)
  professorId  String
  professor    User     @relation("ProfessorMonthlyPayments", fields: [professorId], references: [id], onDelete: Cascade)
  periodYear   Int
  periodMonth  Int // 1-12
  amountCents  Int
  currency     String   @default("inr")
  paidAt       DateTime
  notes        String?
  recordedById String?
  recordedBy   User?    @relation("MonthlyPaymentsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([studentId, professorId, periodYear, periodMonth])
}

// What was actually paid out to a professor for a given month — manually
// logged, not auto-calculated from revenue.
model ProfessorPayout {
  id           String   @id @default(cuid())
  professorId  String
  professor    User     @relation("ProfessorPayouts", fields: [professorId], references: [id], onDelete: Cascade)
  periodYear   Int
  periodMonth  Int
  amountCents  Int
  currency     String   @default("inr")
  paidAt       DateTime
  notes        String?
  recordedById String?
  recordedBy   User?    @relation("ProfessorPayoutsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([professorId])
}

// One row per billing charge for an external service (Vercel, Neon, Twilio,
// Daily.co, OpenAI, Resend, ...) — logged manually as each bill actually
// comes in, kept in its own currency and converted for the P&L using
// ExchangeRate.
model SubscriptionExpense {
  id           String   @id @default(cuid())
  serviceName  String
  amountCents  Int
  currency     String   @default("usd")
  billedAt     DateTime
  notes        String?
  recordedById String?
  recordedBy   User?    @relation("SubscriptionExpensesRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

// A single admin-editable conversion rate per currency pair — the P&L and
// expense log convert every non-INR amount using whatever's stored here
// until a superadmin updates it again. No external FX API involved.
model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  updatedById  String?
  updatedBy    User?    @relation("ExchangeRatesUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}
